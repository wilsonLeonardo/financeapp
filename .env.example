# Application
APP_ENV=development
SERVER_PORT=8080
LOG_LEVEL=info

# Database
POSTGRES_USER=financeapp
POSTGRES_PASSWORD=financeapp123
POSTGRES_DB=financeapp

# Redis
REDIS_PASSWORD=redis123

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key
JWT_EXPIRY_HOURS=24

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
VITE_AI_URL=http://localhost:8000

# AI service — local models served by Ollama
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# Host ports — change any that another stack on your machine already uses
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
AI_HOST_PORT=8000
OLLAMA_HOST_PORT=11434
